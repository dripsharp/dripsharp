{:schema-version 1
 :product-family :pdfcube
 :pdfcube-product :fontbox
 :baseline-target :pdfcube
 :baseline-profile :fontbox
 :baseline-legal-sets [:upstream]
 :destination-bundle dripsharp.pdfcube.java-project/rule-bundle
 :project {:assembly-name "PdfCube.FontBox"
           :root-namespace "PdfCube.FontBox"
           :target-framework "net10.0"
           :nullable "disable"
           :implicit-usings false
           :warnings-as-errors true}
 :package {:id "PdfCube.FontBox"
           :title "PdfCube FontBox"
           :description "Apache FontBox font parsing and subsetting for .NET, mechanically translated by DripSharp."
           :authors "Vibeformer"
           :copyright "Portions Copyright The Apache Software Foundation and other upstream contributors; see NOTICE.txt."
           :symbols :snupkg
           :tags "pdf pdfbox fonts opentype truetype dotnet pdfcube"
           :project-url "https://pdfbox.apache.org/"
           :repository-url "https://github.com/apache/pdfbox.git"
           :repository-type "git"}
 :output {:project-directory "generated/pdfcube-fontbox"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "PdfCube.FontBox.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :package-consumer
 {:strategy :source-file
  :project-file "PdfCube.FontBox.PackageConsumer.csproj"
  :source-path
  "targets/pdfcube/validation/probe/PdfCube.FontBox.FocusedConsumer.cs"
  :success-message "PdfCube.FontBox focused behavior passed."}
 :name-policy {:public-identifiers :csharp
               :methods :methods
               :fields :fields
               :overloads :overloads}
 :namespaces {}
 :namespace-prefixes {"org.apache.fontbox" "PdfCube.FontBox"}
 :external-namespace-prefixes {"org.apache.pdfbox.io" "PdfCube.IO"}
 :resources {}
 :resource-policy {:strategy :embedded-resource-preserve-path}
 :package-dependencies ["PdfCube.IO"]
 :project-references ["../pdfcube-io/PdfCube.IO.csproj"]
 :external-dependencies
 {"commons-logging:commons-logging:jar:1.4.0"
  {:source-scope :compile-runtime
   :runtime-package true
   :destination {:kind :microsoft-package
                 :id "Microsoft.Extensions.Logging.Abstractions"
                 :version "10.0.0"}}}
 :runtime-packages
 [{:id "Microsoft.Extensions.Logging.Abstractions"
   :version "10.0.0"
   :projection :microsoft-package}
  {:id "SkiaSharp"
   :version "4.150.1"
   :projection :skia-sharp}
  {:id "SkiaSharp.NativeAssets.Linux"
   :version "4.150.1"
   :projection :skia-sharp-native-assets}]
 :internal-capabilities #{:font-discovery :icc :skia-geometry}
 :destination-capabilities #{:java-bidi :java-compat :java-regex-unicode}
 :runtime-sources
 ["runtime/PdfCube.FontBox.Compat.cs"
  "runtime/PdfCube.FontBox.Discovery.cs"
  "runtime/PdfCube.Icc.cs"
  "runtime/PdfCube.ImageCodecs.Unsupported.cs"]
 :compatibility-namespace "PdfCube.FB.Runtime"
 :public-surface
 {:strategy dripsharp.pdfcube.java-project/public-surface-strategy}}
