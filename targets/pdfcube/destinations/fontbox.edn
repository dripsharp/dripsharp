{:schema-version 1
 :product-family :pdfcarton
 :pdfcube-product :fontbox
 :baseline-target :pdfcube
 :baseline-profile :fontbox
 :baseline-legal-sets [:upstream]
 :destination-bundle dripsharp.pdfcube.java-project/rule-bundle
 :project {:assembly-name "DripSharp.PdfCarton.Fonts"
           :root-namespace "DripSharp.PdfCarton.Fonts"
           :target-framework "netstandard2.0"
           :nullable "disable"
           :implicit-usings false
           :warnings-as-errors true}
 :package {:id "DripSharp.PdfCarton.Fonts"
           :title "PdfCarton Fonts"
           :description "Apache FontBox font parsing and subsetting for .NET, mechanically translated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by the Apache Software Foundation."
           :authors "Isak Sky"
           :copyright "Portions Copyright The Apache Software Foundation and other upstream contributors; see NOTICE.txt."
           :symbols :snupkg
           :tags "pdf pdfbox fonts opentype truetype dotnet pdfcarton"
           :project-url "https://github.com/dripsharp/pdfcarton"
           :repository-url "https://github.com/dripsharp/pdfcarton.git"
           :repository-type "git"
           :repository-commit-policy :exact-clean-generated-product-commit
           :readme "README.md"}
 :package-readme-source "../../README.md"
 :output {:project-directory "generated/pdfcarton/src/DripSharp.PdfCarton.Fonts"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "DripSharp.PdfCarton.Fonts.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :package-consumer
 {:strategy :source-file
  :project-file "DripSharp.PdfCarton.Fonts.PackageConsumer.csproj"
  :source-path
  "targets/pdfcube/validation/probe/DripSharp.PdfCarton.Fonts.FocusedConsumer.cs"
  :success-message "DripSharp.PdfCarton.Fonts focused behavior passed."}
 :name-policy {:public-identifiers :csharp
               :methods :methods
               :fields :fields
               :overloads :overloads}
 :namespaces {}
 :namespace-prefixes {"org.apache.fontbox" "DripSharp.PdfCarton.Fonts"}
 :external-namespace-prefixes {"org.apache.pdfbox.io" "DripSharp.PdfCarton.IO"}
 :resources {}
 :resource-policy {:strategy :embedded-resource-preserve-path}
 :package-dependencies ["DripSharp.PdfCarton.IO"]
 :project-references
 ["../DripSharp.PdfCarton.IO/DripSharp.PdfCarton.IO.csproj"]
 :friend-assemblies #{"DripSharp.PdfCarton.Tests"}
 :external-dependencies
 {"commons-logging:commons-logging:jar:1.4.0"
  {:source-scope :compile-runtime
   :runtime-package true
   :destination {:kind :microsoft-package
                 :id "Microsoft.Extensions.Logging.Abstractions"
                 :version "10.0.0"}}}
 :runtime-packages
 [{:id "Microsoft.Extensions.Logging.Abstractions"
   :version "10.0.0"
   :projection :microsoft-package}
  {:id "Microsoft.CSharp"
   :version "4.7.0"
   :projection :netstandard-compatibility}
  {:id "System.Memory"
   :version "4.6.3"
   :projection :netstandard-compatibility}
  {:id "System.Formats.Asn1"
   :version "10.0.0"
   :projection :netstandard-compatibility}
  {:id "System.Text.Encoding.CodePages"
   :version "10.0.0"
   :projection :netstandard-compatibility}
  {:id "SkiaSharp"
   :version "4.150.1"
   :projection :skia-sharp}
  {:id "SkiaSharp.NativeAssets.Linux"
   :version "4.150.1"
   :projection :skia-sharp-native-assets}]
 :internal-capabilities #{:font-discovery :icc :skia-geometry}
 :destination-capabilities #{:java-bidi :java-compat :java-regex-unicode}
 :runtime-sources
 ["runtime/DripSharp.PdfCarton.Fonts.Compat.cs"
  "runtime/DripSharp.PdfCarton.Fonts.Discovery.cs"
  "runtime/DripSharp.PdfCarton.Icc.cs"
  "runtime/DripSharp.PdfCarton.ImageCodecs.Unsupported.cs"]
 :compatibility-namespace "DripSharp.PdfCarton.Runtime.Fonts"
 :public-surface
 {:strategy dripsharp.pdfcube.java-project/public-surface-strategy}}
