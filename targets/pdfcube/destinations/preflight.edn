  "org.apache.pdfbox" "DripSharp.PdfCarton"
  "org.apache.xmpbox" "DripSharp.PdfCarton.Xmp"}
 :resources {}
 :resource-policy {:strategy :embedded-resource-preserve-path}
 :package-dependencies ["DripSharp.PdfCarton" "DripSharp.PdfCarton.Xmp"]
