   :runtime-package true
   :destination {:kind :microsoft-package
                 :id "Microsoft.Extensions.Logging.Abstractions"
                 :version "10.0.0"}}}
 :runtime-packages
 [{:id "Microsoft.Extensions.Logging.Abstractions"
   :version "10.0.0"
   :projection :microsoft-package}
  {:id "Microsoft.CSharp"
   :version "4.7.0"
   :projection :netstandard-compatibility}
  {:id "System.Memory"
   :version "4.6.3"
   :projection :netstandard-compatibility}
  {:id "System.Text.Encoding.CodePages"
