{:schema-version 1
 :product-family :pdfcube
 :pdfcube-product :preflight
 :baseline-target :pdfcube
 :baseline-profile :preflight
 :baseline-legal-sets [:upstream]
 :destination-bundle dripsharp.pdfcube.java-project/rule-bundle
 :project {:assembly-name "PdfCube.Preflight"
           :root-namespace "PdfCube.Preflight"
           :target-framework "net10.0"
           :nullable "disable"
           :implicit-usings false
           :warnings-as-errors true}
 :package {:id "PdfCube.Preflight"
           :title "PdfCube Preflight"
           :description "Apache Preflight PDF/A validation APIs for .NET, mechanically translated by DripSharp."
           :authors "Vibeformer"
           :copyright "Portions Copyright The Apache Software Foundation and other upstream contributors; see NOTICE.txt."
           :symbols :snupkg
           :tags "pdf pdfbox pdfa validation preflight dotnet pdfcube"
           :project-url "https://pdfbox.apache.org/"
           :repository-url "https://github.com/apache/pdfbox.git"
           :repository-type "git"}
 :output {:project-directory "generated/pdfcube-preflight"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "PdfCube.Preflight.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :package-consumer
 {:strategy :source-file
  :project-file "PdfCube.Preflight.PackageConsumer.csproj"
  :source-path
  "targets/pdfcube/validation/probe/PdfCube.Preflight.FocusedConsumer.cs"
  :success-message "PdfCube.Preflight focused behavior passed."}
 :name-policy {:public-identifiers :csharp
               :methods :methods
               :fields :fields
               :overloads :overloads}
 :namespaces {}
 :namespace-prefixes {"org.apache.pdfbox.preflight" "PdfCube.Preflight"}
 :external-namespace-prefixes
 {"org.apache.fontbox" "PdfCube.FontBox"
  "org.apache.pdfbox.io" "PdfCube.IO"
  "org.apache.pdfbox" "PdfCube.PdfBox"
  "org.apache.xmpbox" "PdfCube.XmpBox"}
 :resources {}
 :resource-policy {:strategy :embedded-resource-preserve-path}
 :package-dependencies ["PdfCube.PdfBox" "PdfCube.XmpBox"]
 :project-references
 ["../pdfcube-pdfbox/PdfCube.PdfBox.csproj"
  "../pdfcube-xmpbox/PdfCube.XmpBox.csproj"]
 :external-dependencies
 {"commons-logging:commons-logging:jar:1.4.0"
  {:source-scope :compile-runtime
   :runtime-package true
   :destination {:kind :microsoft-package
                 :id "Microsoft.Extensions.Logging.Abstractions"
                 :version "10.0.0"}}}
 :runtime-packages
 [{:id "Microsoft.Extensions.Logging.Abstractions"
   :version "10.0.0"
   :projection :microsoft-package}
  {:id "SkiaSharp"
   :version "4.150.1"
   :projection :skia-sharp}]
 :internal-capabilities #{:preflight-font-erasure}
 :generic-erasure-mappings
 {"org.apache.pdfbox.preflight.font.container.FontContainer"
  "global::PdfCube.Preflight.Font.Container.IFontContainer"
  "org.apache.pdfbox.preflight.font.FontValidator"
  "global::PdfCube.Preflight.Font.IFontValidator"}
 :destination-capabilities #{:java-compat :java-regex-unicode}
 :bridge-capabilities #{}
 :runtime-sources ["runtime/PdfCube.Preflight.Compat.cs"]
 :public-surface
 {:strategy dripsharp.pdfcube.java-project/public-surface-strategy}}
