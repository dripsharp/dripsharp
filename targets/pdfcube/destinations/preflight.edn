  "../DripSharp.PdfCarton.Xmp/DripSharp.PdfCarton.Xmp.csproj"]
 :friend-assemblies #{"DripSharp.PdfCarton.Tests"}
 :external-dependencies
 {"commons-logging:commons-logging:jar:1.4.0"
