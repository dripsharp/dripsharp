  {:id "Microsoft.CSharp"
   :version "4.7.0"
   :projection :netstandard-compatibility}
  {:id "System.Memory"
   :version "4.6.3"
   :projection :netstandard-compatibility}
  {:id "System.Text.Encoding.CodePages"
   :version "10.0.0"
   :projection :netstandard-compatibility}
  {:id "System.Security.Cryptography.Pkcs"
   :version "10.0.0"
   :projection :microsoft-package}
  {:id "SkiaSharp"
   :version "4.150.1"
   :projection :skia-sharp}]
