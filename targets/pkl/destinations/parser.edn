{:schema-version 1
 :product-family :pkl
 :baseline-target :pkl
 :baseline-profile :parser
 :destination-bundle dripsharp.pkl.java-project/rule-bundle
 :project {:assembly-name "Pkl.Parser"
           :root-namespace "Pkl.Parser"
           :target-framework "net8.0"
           :nullable "enable"
           :implicit-usings false
           :define-constants ["DRIPSHARP_INTERNAL_JAVA_COMPAT"]
           :warnings-as-errors true}
 :package {:id "Pkl.Parser"
           :title "Pkl parser for .NET"
           :description "Pkl parser library for .NET, generated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by Apple Inc."
           :authors "Vibeformer"
           :tags "pkl parser dotnet dripsharp"
           :project-url "https://github.com/isaksky/pkl-net"
           :repository-url "https://github.com/isaksky/pkl-net.git"
           :repository-type "git"}
 :output {:project-directory "generated/pkl-parser"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "Pkl.Parser.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :namespaces {"org.pkl.parser" "Pkl.Parser"
              "org.pkl.parser.syntax" "Pkl.Parser.Syntax"
              "org.pkl.parser.syntax.generic" "Pkl.Parser.Syntax.Generic"
              "org.pkl.parser.util" "Pkl.Parser.Util"}
 :destination-capabilities #{:java-compat :java-regex-unicode}
 :public-surface {:strategy dripsharp.pkl.public-api-contract/strategy
                  :source-module "pkl-parser"}
 :package-consumer {:strategy :source-file
                    :project-file "Pkl.Parser.PackageConsumer.csproj"
                    :source-path
                    "targets/pkl/validation/probe/ParserPackageConsumer.cs"
                    :success-message "Independent Pkl.Parser package consumer passed."}
 :resources {"org/pkl/parser/errorMessages.properties"
             {:strategy :embedded-resource
              :destination "org/pkl/parser/errorMessages.properties"
              :logical-name "org.pkl.parser.errorMessages.properties"}}}
