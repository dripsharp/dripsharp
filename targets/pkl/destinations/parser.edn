{:schema-version 1
 :product-family :brine
 :baseline-target :pkl
 :baseline-profile :parser
 :baseline-legal-sets [:core]
 :destination-bundle dripsharp.pkl.java-project/rule-bundle
 :project {:assembly-name "DripSharp.Brine.Parser"
           :root-namespace "DripSharp.Brine.Parser"
           :target-framework "net10.0"
           :nullable "enable"
           :implicit-usings false
           :define-constants ["DRIPSHARP_INTERNAL_JAVA_COMPAT"]
           :warnings-as-errors true}
 :package {:id "DripSharp.Brine.Parser"
           :title "Brine Parser — Pkl for .NET"
           :description "Brine Parser is a Pkl parser library for .NET, generated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by Apple Inc."
           :authors "Isak Sky"
           :copyright "Portions Copyright Apple Inc. and other Pkl contributors; see NOTICE.txt."
           :tags "brine pkl parser dotnet dripsharp"
           :project-url "https://github.com/dripsharp/brine"
           :repository-url "https://github.com/dripsharp/brine.git"
           :repository-type "git"
           :repository-commit-policy :exact-clean-generated-product-commit
           :readme "README.md"}
 :package-readme-source "../../README.md"
 :output {:project-directory "generated/brine/src/DripSharp.Brine.Parser"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "DripSharp.Brine.Parser.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :namespaces {"org.pkl.parser" "DripSharp.Brine.Parser"
              "org.pkl.parser.syntax" "DripSharp.Brine.Parser.Syntax"
              "org.pkl.parser.syntax.generic" "DripSharp.Brine.Parser.Syntax.Generic"
              "org.pkl.parser.util" "DripSharp.Brine.Parser.Util"}
 :destination-capabilities #{:java-compat :java-regex-unicode}
 :public-surface {:strategy dripsharp.pkl.public-api-contract/strategy
                  :source-module "pkl-parser"}
 :package-consumer {:strategy :source-file
                    :project-file "DripSharp.Brine.Parser.PackageConsumer.csproj"
                    :source-path
                    "targets/pkl/validation/probe/ParserPackageConsumer.cs"
                    :success-message "Independent Brine Pkl parser package consumer passed."}
 :resources {"org/pkl/parser/errorMessages.properties"
             {:strategy :embedded-resource
              :destination "org/pkl/parser/errorMessages.properties"
              :logical-name "org.pkl.parser.errorMessages.properties"}}}
