{:schema-version 1
 :product-family :brine
 :baseline-target :pkl
 :baseline-profile :core
 :baseline-legal-sets [:core]
 :destination-bundle dripsharp.pkl.java-project/rule-bundle
 :project {:assembly-name "DripSharp.Brine"
           :root-namespace "DripSharp.Brine"
           :target-framework "net10.0"
           :nullable "enable"
           :implicit-usings false
           :define-constants ["DRIPSHARP_INTERNAL_JAVA_COMPAT"]
           :warnings-as-errors true
           :no-warn ["CS0108" "CS0109" "CS0414" "CS0436" "CS0649" "CS0693"
                     "CS8600" "CS8601" "CS8602" "CS8603" "CS8604"
                     "CS8619" "CS8620" "CS8629" "CS8605" "CS0162"
                     "CS8714" "CS8764" "CS8765" "CS8767"]}
 :package {:id "DripSharp.Brine"
           :title "Brine — Pkl for .NET"
           :description "Brine is a Pkl evaluation, runtime, and value-model library for .NET, generated by DripSharp. This package is an independent translation and is not affiliated with, endorsed by, or sponsored by Apple Inc."
           :authors "Vibeformer"
           :tags "brine pkl evaluator runtime value-model dotnet dripsharp"
           :project-url "https://github.com/isaksky/pkl-net"
           :repository-url "https://github.com/isaksky/pkl-net.git"
           :repository-type "git"}
 :output {:project-directory "generated/brine/src/DripSharp.Brine"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "DripSharp.Brine.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :namespaces {"org.pkl.core" "DripSharp.Brine"}
 :namespace-prefixes {"org.pkl.core" "DripSharp.Brine"}
 :destination-capabilities #{:java-compat :java-regex-unicode}
 :public-surface {:strategy dripsharp.pkl.public-api-contract/strategy
                  :source-module "pkl-core"}
 :package-consumer {:strategy :source-file
                    :project-file "DripSharp.Brine.PackageConsumer.csproj"
                    :source-path
                    "targets/pkl/validation/probe/CorePackageConsumer.cs"
                    :success-message "Independent Brine Pkl package consumer passed."}
 :resources {}
 :project-references ["../DripSharp.Brine.Parser/DripSharp.Brine.Parser.csproj"]
 :runtime-sources ["runtime/DripSharp.Brine.Substrate.cs"
                   "runtime/DripSharp.Brine.RuntimeBridge.cs"
                   "runtime/DripSharp.Brine.DotNet.cs"
                   "runtime/DripSharp.Brine.ValueModel.DotNet.cs"
                   "runtime/DripSharp.Brine.Loading.cs"]
 :resource-policy {:strategy :embedded-resource-preserve-path}}
