<Project>
  <PropertyGroup>
    <PdfCartonBaselinePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\targets\pdfcube\baseline.edn'))</PdfCartonBaselinePath>
    <PdfCartonBaselineText>$([System.IO.File]::ReadAllText('$(PdfCartonBaselinePath)'))</PdfCartonBaselineText>
    <PdfCartonIOPackageVersion>$([System.Text.RegularExpressions.Regex]::Match('$(PdfCartonBaselineText)', '&quot;DripSharp\.PdfCarton\.IO&quot;\s+\{:version\s+&quot;([^&quot;]+)&quot;').Groups[1].Value)</PdfCartonIOPackageVersion>
    <PdfCartonFontsPackageVersion>$([System.Text.RegularExpressions.Regex]::Match('$(PdfCartonBaselineText)', '&quot;DripSharp\.PdfCarton\.Fonts&quot;\s+\{:version\s+&quot;([^&quot;]+)&quot;').Groups[1].Value)</PdfCartonFontsPackageVersion>
    <PdfCartonXmpPackageVersion>$([System.Text.RegularExpressions.Regex]::Match('$(PdfCartonBaselineText)', '&quot;DripSharp\.PdfCarton\.Xmp&quot;\s+\{:version\s+&quot;([^&quot;]+)&quot;').Groups[1].Value)</PdfCartonXmpPackageVersion>
    <PdfCartonPackageVersion>$([System.Text.RegularExpressions.Regex]::Match('$(PdfCartonBaselineText)', '&quot;DripSharp\.PdfCarton&quot;\s+\{:version\s+&quot;([^&quot;]+)&quot;').Groups[1].Value)</PdfCartonPackageVersion>
    <PdfCartonPreflightPackageVersion>$([System.Text.RegularExpressions.Regex]::Match('$(PdfCartonBaselineText)', '&quot;DripSharp\.PdfCarton\.Preflight&quot;\s+\{:version\s+&quot;([^&quot;]+)&quot;').Groups[1].Value)</PdfCartonPreflightPackageVersion>
  </PropertyGroup>

  <Target Name="ValidatePdfCartonBaselinePackageVersions"
          BeforeTargets="CollectPackageReferences"
          Condition="'@(PackageReference)' != '' and $([System.String]::Copy('@(PackageReference)').Contains('DripSharp.PdfCarton'))">
    <Error Condition="'$(PdfCartonIOPackageVersion)' == '' or
                      '$(PdfCartonFontsPackageVersion)' == '' or
                      '$(PdfCartonXmpPackageVersion)' == '' or
                      '$(PdfCartonPackageVersion)' == '' or
                      '$(PdfCartonPreflightPackageVersion)' == ''"
           Text="targets/pdfcube/baseline.edn does not contain every PdfCarton package version." />
  </Target>
</Project>
