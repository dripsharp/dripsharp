{:schema-version 1
 :product-family :pdfcube
 :pdfcube-product :xmpbox
 :baseline-target :pdfcube
 :baseline-profile :xmpbox
 :baseline-legal-sets [:upstream]
 :destination-bundle dripsharp.pdfcube.java-project/rule-bundle
 :project {:assembly-name "PdfCube.XmpBox"
           :root-namespace "PdfCube.XmpBox"
           :target-framework "net10.0"
           :nullable "disable"
           :implicit-usings false
           :warnings-as-errors true}
 :package {:id "PdfCube.XmpBox"
           :title "PdfCube XmpBox"
           :description "Apache XmpBox metadata APIs for .NET, mechanically translated by DripSharp."
           :authors "Vibeformer"
           :copyright "Portions Copyright The Apache Software Foundation and other upstream contributors; see NOTICE.txt."
           :symbols :snupkg
           :tags "pdf pdfbox xmp metadata xml dotnet pdfcube"
           :project-url "https://pdfbox.apache.org/"
           :repository-url "https://github.com/apache/pdfbox.git"
           :repository-type "git"}
 :output {:project-directory "generated/pdfcube-xmpbox"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "PdfCube.XmpBox.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :package-consumer
 {:strategy :source-file
  :project-file "PdfCube.XmpBox.PackageConsumer.csproj"
  :source-path "validation/pdfcube-xmpbox/PdfCube.XmpBox.FocusedConsumer.cs"
  :success-message "PdfCube.XmpBox focused behavior passed."}
 :name-policy {:public-identifiers :csharp
               :methods :methods
               :fields :fields
               :overloads :overloads}
 :namespaces {}
 :namespace-prefixes {"org.apache.xmpbox" "PdfCube.XmpBox"}
 :external-namespace-prefixes {}
 :resources {}
 :resource-policy {:strategy :embedded-resource-preserve-path}
 :project-dependencies []
 :package-dependencies []
 :project-references []
 :external-dependencies
 {"commons-logging:commons-logging:jar:1.4.0"
  {:source-scope :compile-runtime
   :runtime-package true
   :destination {:kind :microsoft-package
                 :id "Microsoft.Extensions.Logging.Abstractions"
                 :version "10.0.0"}}}
 :runtime-packages
 [{:id "Microsoft.Extensions.Logging.Abstractions"
   :version "10.0.0"
   :projection :microsoft-package}]
 :internal-capabilities #{:xml}
 :destination-capabilities #{:java-compat :java-regex-unicode}
 :compatibility-namespace "PdfCube.XMP.Runtime"
 :public-surface
 {:strategy dripsharp.pdfcube.java-project/public-surface-strategy}}
