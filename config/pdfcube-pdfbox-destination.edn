{:schema-version 1
 :product-family :pdfcube
 :pdfcube-product :pdfbox
 :baseline-target :pdfcube
 :baseline-profile :pdfbox
 :baseline-legal-sets [:upstream :codecs]
 :destination-bundle dripsharp.pdfcube.java-project/rule-bundle
 :project {:assembly-name "PdfCube.PdfBox"
           :root-namespace "PdfCube.PdfBox"
           :target-framework "net10.0"
           :nullable "disable"
           :implicit-usings false
           :warnings-as-errors true}
 :package {:id "PdfCube.PdfBox"
           :title "PdfCube PDFBox"
           :description "Apache PDFBox document, parsing, rendering, and manipulation APIs for .NET, mechanically translated by DripSharp."
           :authors "Vibeformer"
           :copyright "Portions Copyright The Apache Software Foundation and other upstream contributors; see NOTICE.txt."
           :symbols :snupkg
           :tags "pdf pdfbox documents rendering parsing dotnet pdfcube"
           :project-url "https://pdfbox.apache.org/"
           :repository-url "https://github.com/apache/pdfbox.git"
           :repository-type "git"}
 :output {:project-directory "generated/pdfcube-pdfbox"
          :source-directory "src"
          :resource-directory "resources"
          :project-file "PdfCube.PdfBox.csproj"
          :source-map-file "source-map.edn"
          :diagnostics-file "diagnostics.edn"
          :manifest-file "generation-manifest.edn"
          :public-metadata-file "public-metadata.edn"
          :annotation-decisions-file "annotation-decisions.edn"}
 :package-consumer
 {:strategy :compile-only
  :project-file "PdfCube.PdfBox.PackageConsumer.csproj"
  :compile-types
  ["PdfCube.PdfBox.Cos.COSDocument"
   "PdfCube.PdfBox.Pdmodel.PDDocument"]
  :success-message "PdfCube.PdfBox package boundary passed."}
 :name-policy {:public-identifiers :csharp
               :methods :methods
               :fields :fields
               :overloads :overloads}
 :namespaces {}
 :namespace-prefixes {"org.apache.pdfbox" "PdfCube.PdfBox"}
 :external-namespace-prefixes
 {"org.apache.fontbox" "PdfCube.FontBox"
  "org.apache.pdfbox.io" "PdfCube.IO"}
 :resources {}
 :resource-policy {:strategy :embedded-resource-preserve-path}
 :package-dependencies ["PdfCube.IO" "PdfCube.FontBox"]
 :project-references
 ["../pdfcube-io/PdfCube.IO.csproj"
  "../pdfcube-fontbox/PdfCube.FontBox.csproj"]
 :friend-assemblies #{"PdfCube.Preflight"}
 :external-dependencies
 {"commons-logging:commons-logging:jar:1.4.0"
  {:source-scope :compile-runtime
   :runtime-package true
   :destination {:kind :microsoft-package
                 :id "Microsoft.Extensions.Logging.Abstractions"
                 :version "10.0.0"}}
  "org.bouncycastle:bcpkix-jdk18on:jar:1.84"
  {:source-scope :compile-runtime
   :runtime-package true
   :destination
   {:kind :microsoft-package
    :id "System.Security.Cryptography.Pkcs"
    :version "10.0.0"
    :capabilities
    ["System.Security.Cryptography.Pkcs"
     "System.Formats.Asn1"
     "System.Security.Cryptography.X509Certificates"]}}
  "org.bouncycastle:bcprov-jdk18on:jar:1.84"
  {:source-scope :compile-runtime
   :runtime-package false
   :destination
   {:kind :bcl
    :capabilities
    ["System.Security.Cryptography"
     "System.Security.Cryptography.X509Certificates"]}}
  "org.bouncycastle:bcutil-jdk18on:jar:1.84"
  {:source-scope :compile-runtime
   :runtime-package false
   :destination
   {:kind :bcl
    :capabilities
    ["System.Security.Cryptography"
     "System.Formats.Asn1"]}}}
 :runtime-packages
 [{:id "Microsoft.Extensions.Logging.Abstractions"
   :version "10.0.0"
   :projection :microsoft-package}
  {:id "System.Security.Cryptography.Pkcs"
   :version "10.0.0"
   :projection :microsoft-package}
  {:id "SkiaSharp"
   :version "4.150.1"
   :projection :skia-sharp}]
 :internal-capabilities
 #{:calendar-value-semantics :icc :jbig2 :jpx :managed-raster :printing
   :security-handler-erasure :skia-graphics :unicode-bidi}
 :destination-capabilities #{:java-bidi :java-compat :java-regex-unicode}
 :bridge-capabilities #{:java-bidi}
 :public-surface
 {:strategy dripsharp.pdfcube.java-project/public-surface-strategy}}
