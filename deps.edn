{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.22.0"}
        fr.inria.gforge.spoon/spoon-core {:mvn/version "11.4.0"}}
 :aliases
 {:run
  {:jvm-opts ["-Xmx8g"]
   :main-opts ["-m" "dripsharp.main"]}

  :verify-authored-spdx
  {:jvm-opts ["-Xms64m" "-Xmx512m"]
   :main-opts ["-m" "dripsharp.authored-spdx"]}

  :test
  {:jvm-opts ["-Xmx8g"]
   :extra-deps
   {com.h2database/h2 {:mvn/version "2.3.232"}
    org.assertj/assertj-core {:mvn/version "3.27.7"}
    org.hamcrest/hamcrest {:mvn/version "3.0"}
    org.mockito/mockito-core {:mvn/version "4.11.0"}
    org.mockito/mockito-junit-jupiter {:mvn/version "4.11.0"}
    junit/junit {:mvn/version "4.13.2"}
    org.junit.jupiter/junit-jupiter-api {:mvn/version "5.13.4"}
    org.junit.jupiter/junit-jupiter-params {:mvn/version "5.13.4"}}
   :extra-paths ["test"]
   :main-opts ["-m" "dripsharp.test-runner"]}

  :unit-test
  {:jvm-opts ["-Xms64m" "-Xmx512m"]
   :extra-paths ["test"]
   :main-opts ["-m" "dripsharp.test-runner" "--tier" "unit"]}

  ;; Validation CLI over Java PDFBox; see validation/pdfcarton-cli/contract.md.
  :pdfcli
  {:replace-deps
   {org.clojure/clojure {:mvn/version "1.12.5"}
    org.apache.pdfbox/pdfbox {:mvn/version "3.0.8"}
    org.apache.pdfbox/xmpbox {:mvn/version "3.0.8"}
    org.apache.pdfbox/jbig2-imageio {:mvn/version "3.0.5"}
    com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.22.0"}}
   :replace-paths ["validation/pdfcarton-cli/jvm/src"]
   :jvm-opts ["-Djava.awt.headless=true"]
   :main-opts ["-m" "pdfcli.main"]}

  :pdfcli-test
  {:replace-deps
   {org.clojure/clojure {:mvn/version "1.12.5"}
    org.apache.pdfbox/pdfbox {:mvn/version "3.0.8"}
    org.apache.pdfbox/xmpbox {:mvn/version "3.0.8"}
    org.apache.pdfbox/jbig2-imageio {:mvn/version "3.0.5"}
    com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.22.0"}}
   :replace-paths ["validation/pdfcarton-cli/jvm/src" "validation/pdfcarton-cli/jvm/test"]
   :jvm-opts ["-Djava.awt.headless=true" "-Xmx4g"]
   :main-opts ["-m" "pdfcli.main-test"]}}}
