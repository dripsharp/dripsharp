@Deprecated { since = "1.2"; message = "contract"; replaceWith = "replacement" }
@Unlisted
@ModuleInfo { minPklVersion = "0.26.0" }
amends "pkl:Project"

evaluatorSettings {
  timeout = 2.s
  rootDir = "."
  noCache = false
  moduleCacheDir = "cache"
  modulePath { "modules" }
  color = "always"
  traceMode = "pretty"
  env { ["CONTRACT_ENV"] = "project-env" }
  externalProperties { ["contract.property"] = "project-property" }
  allowedModules { "pkl:"; "file:"; "projectpackage:" }
  allowedResources { "file:"; "env:"; "prop:"; "projectpackage:" }
  externalModuleReaders {
    ["contractmod"] {
      executable = "tools/module-reader"
      arguments { "--contract" }
      workingDir = "reader-work"
    }
  }
  externalResourceReaders {
    ["contractres"] {
      executable = "contract-resource-reader"
    }
  }
  http {
    proxy {
      address = "http://localhost:8080"
      noProxy { "example.test" }
    }
    rewrites { ["https://origin.test/"] = "https://mirror.test/" }
    headers {
      ["https://mirror.test/**"] { ["X-Contract"] = "enabled" }
    }
  }
}

package {
  name = "contract-project"
  baseUri = "package://example.test/contract-project"
  version = "1.2.3"
  description = "Contract project"
  packageZipUrl = "https://example.test/contract-project/\(version).zip"
  authors { "Contract Author <contract@example.test>" }
  website = "https://example.test/site"
  documentation = "https://example.test/docs"
  sourceCode = "https://example.test/source"
  sourceCodeUrlScheme = "https://example.test/source/\(version)%{path}"
  license = "Apache-2.0"
  licenseText = "Contract license"
  issueTracker = "https://example.test/issues"
  apiTests { "apiTest.pkl" }
  exclude { "*.tmp" }
}

dependencies {
  ["remote"] { uri = "package://example.test/remote@1.0.0" }
  ["local"] = import("local-dependency/PklProject")
}

tests { "contractTest.pkl" }
